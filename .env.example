# Local development settings. Copy to .env (gitignored) and fill in.
# Hosted environments (development / staging / production on Railway) do NOT use this file:
# their variables are set per environment in Railway. See docs/environments.md and the
# templates in deploy/.
# Wrap values containing # in single quotes, e.g. L27_PASSWORD='abc#123'.

# ---------- Environment ----------
# development | staging | production. On Railway this comes from RAILWAY_ENVIRONMENT_NAME.
APP_ENV=development
PORT=8787
# debug | info | warn | error. Logs are JSON with emails, phones and secrets redacted.
LOG_LEVEL=info

# ---------- Launch27 ----------
# live: the real Launch27 at L27_BASE_URL (read-only outside production).
# mock: built-in synthetic Launch27 (fake customers, cleaners, bookings). Forced on Railway
#       dev/staging so they can never touch real customer data.
L27_MODE=mock
L27_BASE_URL=https://urbanmop.launch27.com
# Sign-in password for every account in mock mode (any email works).
MOCK_PASSWORD=demo
# Production only. Ignored (forced off) in development/staging when L27_MODE=live.
L27_ALLOW_WRITES=false

# ---------- Sessions ----------
# At least 32 random characters in hosted environments. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it signs everyone out.
SESSION_SECRET=change-me-locally

# ---------- Database ----------
# Postgres URL. Empty locally = embedded Postgres (PGlite) in PGLITE_DIR.
DATABASE_URL=
PGLITE_DIR=.data/pglite
DATABASE_POOL_MAX=10
# Apply pending migrations when the server starts. Railway runs them as a pre-deploy
# step instead (railway.json), so this is harmless there.
MIGRATE_ON_BOOT=true

# ---------- Notifications ----------
# sandbox: outbound SMS/email is recorded but never sent. Forced outside production.
NOTIFICATIONS_MODE=sandbox
# Email channel (Gmail): production only, ignored here. See docs/email.md.
# GMAIL_SERVICE_ACCOUNT_JSON=
# GMAIL_MAILBOXES=info@urbanmop.ca,billing@urbanmop.ca
# EMAIL_FROM_NAME=UrbanMop
# EMAIL_POLL_INTERVAL_MS=60000
# SMS through RingCentral (docs/sms.md). Outside production only the RingCentral sandbox
# (platform.devtest.ringcentral.com) is accepted, and sends are always sandboxed.
# RINGCENTRAL_SMS_CLIENT_ID=
# RINGCENTRAL_SMS_CLIENT_SECRET=
# RINGCENTRAL_SMS_JWT=
# RINGCENTRAL_SMS_NUMBERS=+16136919880,+16136918368
# RINGCENTRAL_SMS_WEBHOOK_URL=
# RINGCENTRAL_SMS_WEBHOOK_TOKEN=
# SMS through Twilio (docs/sms.md): production only, ignored here.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_SMS_NUMBERS=
# TWILIO_WEBHOOK_BASE_URL=
# Load ~15 sample support conversations (synthetic customers/cleaners) into the inbox once
# at startup. Needs L27_MODE=mock. Ignored in production.
SAMPLE_DATA=false
# Channel simulator page + POST /api/simulate/inbound. Off by default in production.
INBOX_SIMULATOR=true
# RingCentral Embeddable softphone. Outside production only the sandbox server is allowed
# (https://platform.devtest.ringcentral.com); a production server URL disables the phone.
RINGCENTRAL_CLIENT_ID=
RINGCENTRAL_SERVER=

# ---------- Support workspace ----------
# Comma-separated. The first person to sign in also becomes an admin.
ADMIN_EMAILS=
SUPERVISOR_EMAILS=
# Monthly raise check (a private bell notification per cleaner who looks raise-ready).
# Comma-separated admin emails; empty = every admin.
RAISE_DIGEST_EMAILS=
# Utilization report (Reports → Utilization, read-only): everyone sees it, production included.
# Optional: comma-separated logins to limit it to.
UTILIZATION_EMAILS=

# ---------- Placement API for the Sales Hub (docs/placement.md) ----------
# name:token pairs, comma-separated; tokens 32+ random chars. Empty = API not served.
PLACEMENT_TOKENS=
# Brand slugs the Hub may book (residential, commercial).
PLACEMENT_BRANDS=residential
# Live Launch27 only: the staff login placement bookings are made with.
L27_PLACEMENT_EMAIL=
L27_PLACEMENT_PASSWORD=

# ---------- Capture tool only (npm run capture) ----------
# The admin login it crawls the real portal with. Never used by the server.
L27_EMAIL=
L27_PASSWORD=

# ---------- Complaint Resolution Engine (docs/complaints-engine.md) ----------
# Read in production only; dev/QA run on synthetic Launch27 ratings. All read-only.
# KUSTOMER_API_KEY=            # dedicated key with read-only roles
# KUSTOMER_EXPORT_KEY=         # Kustomer migration: 32+ random chars (encrypts the exported copy; dev/QA use a test key)
# KUSTOMER_EXPORT_RPM=300
# KUSTOMER_COMPLAINT_KLASS=    # optional; found automatically if its name contains "complaint"
# SLACK_BOT_TOKEN=             # Slack app with channels:history, groups:history, users:read
# COMPLAINT_SLACK_CHANNELS=    # optional; default: finance-refunds, finance-operations-collaboration, finance-charges
# ANTHROPIC_API_KEY=           # optional; Claude classifies redacted complaint text (rules only without it)
