# Railway environment: production  (branch: main, domain: app.<your-domain>)
# Template only — no secrets here. The server refuses to start in production unless
# SESSION_SECRET (32+ chars) and DATABASE_URL are set, L27_MODE is live and the
# simulator is off.
APP_ENV=production
L27_MODE=live
L27_BASE_URL=https://urbanmop.launch27.com
L27_ALLOW_WRITES=<true only once the team is ready to edit bookings from this app>
NOTIFICATIONS_MODE=<live once email is connected (docs/email.md); sandbox records replies without sending>
# Email (Gmail). See docs/email.md for the Google Workspace setup.
GMAIL_SERVICE_ACCOUNT_JSON=<service account JSON key with domain-wide delegation>
GMAIL_MAILBOXES=info@urbanmop.ca,billing@urbanmop.ca,customersuccess@urbanmop.ca
# EMAIL_FROM_NAME=UrbanMop
INBOX_SIMULATOR=false
SESSION_SECRET=<32+ random chars, unique to production>
DATABASE_URL=${{Postgres.DATABASE_URL}}
LOG_LEVEL=info
ADMIN_EMAILS=<comma-separated>
# KPI scorecard (docs/kpi.md): only these logins see it in production. Empty = nobody.
# Its daily Launch27 read uses L27_SYNC_EMAIL / L27_SYNC_PASSWORD below.
KPI_EMAILS=<comma-separated>
# The one mailbox that receives the monthly Syft management report (read with the Gmail service account, read-only).
KPI_SYFT_MAILBOX=<mailbox@urbanmop.ca>
# RINGCENTRAL_SERVER=https://platform.ringcentral.com
# RINGCENTRAL_CLIENT_ID=<production app client id>
# Send anonymized copies of real data to QA (Support settings → QA data).
QA_SNAPSHOT_URL=https://<qa site address>
QA_SNAPSHOT_TOKEN=<32+ random chars, same as staging>
# Customer segments: nightly update logs in as this read-only Launch27 staff user.
# Without it, segments only update when an admin clicks "Update now".
L27_SYNC_EMAIL=<read-only Launch27 staff login>
L27_SYNC_PASSWORD=<its password>
# Placement API for the Sales Hub (docs/placement.md). Off until PLACEMENT_TOKENS is set.
# Only the token's hash, scoped to UrbanMop Residential (npm run placement-token -- sales-hub):
PLACEMENT_TOKENS=[{"name":"sales-hub","sha256":"<64 hex>","actions":["read","hold","book"],"brands":["urbanmop-residential"]}]
# Bookings stay off until this is true (independent of L27_ALLOW_WRITES):
PLACEMENT_BOOKING_ENABLED=false
# Optional: only these caller addresses (the Hub's static outbound IPs, if it has them):
# PLACEMENT_ALLOWED_IPS=203.0.113.7,203.0.113.8
L27_PLACEMENT_EMAIL=<Launch27 staff login allowed to create bookings and customers>
L27_PLACEMENT_PASSWORD=<its password>

# Complaint Resolution Engine (docs/complaints-engine.md). All read-only.
KUSTOMER_API_KEY=<dedicated read-only Kustomer key "Complaint Engine">
SLACK_BOT_TOKEN=<xoxb- token: channels:history, groups:history, users:read; bot invited to the finance channels>
ANTHROPIC_API_KEY=<optional: Claude classification of redacted complaint text>
# SMS through RingCentral (docs/sms.md): server-side JWT app with SMS, Read Messages, Read Accounts
# and WebHook Subscriptions permissions. Production platform only.
RINGCENTRAL_SMS_CLIENT_ID=<RingCentral app client id>
RINGCENTRAL_SMS_CLIENT_SECRET=<RingCentral app client secret>
RINGCENTRAL_SMS_JWT=<JWT credential of the support extension>
RINGCENTRAL_SMS_NUMBERS=+16136919880,+16136918368
RINGCENTRAL_SMS_WEBHOOK_URL=https://<production domain>/webhooks/ringcentral/sms
RINGCENTRAL_SMS_WEBHOOK_TOKEN=<16-64 random chars>
# SMS through Twilio (docs/sms.md). Numbers here must not also be in RINGCENTRAL_SMS_NUMBERS.
TWILIO_ACCOUNT_SID=<Twilio Account SID>
TWILIO_AUTH_TOKEN=<Twilio Auth Token>
TWILIO_SMS_NUMBERS=<Twilio numbers, comma-separated, E.164>
TWILIO_WEBHOOK_BASE_URL=https://<production domain>
# Kustomer migration (docs/kustomer-migration.md): encrypts the exported copy. Keep it only here.
KUSTOMER_EXPORT_KEY=<32+ random chars>
# KUSTOMER_EXPORT_RPM=300
